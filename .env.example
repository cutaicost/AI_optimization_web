APP_ENV=development
# Railway commonly injects postgresql://; the application normalizes it to psycopg.
DATABASE_URL=
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_SITH_PASSWORD=
ADMIN_BEYOND_PASSWORD=
ALLOWED_ORIGINS=http://127.0.0.1:3000
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
IMPORT_TEMP_DIR=
IMPORT_STORAGE_ROOT=
EMBEDDED_IMPORT_WORKER=false
WORKER_HEARTBEAT_SECONDS=15
WORKER_LEASE_SECONDS=90
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
OIDC_ROLE_CLAIM=roles
OIDC_ROLE_MAP=viewer=VIEWER,analyst=ANALYST,administrator=ADMIN
BACKUP_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_MASTER_KEY=
# Production example values (set these in Railway, never in this file):
# APP_ENV=production
# ALLOWED_ORIGINS=https://cutaicost.com
# COOKIE_SECURE=true
# OIDC_REDIRECT_URI=https://cutaicost.com/api/v1/auth/oidc/callback
