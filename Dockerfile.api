FROM python:3.11-slim
WORKDIR /app
COPY apps/api/requirements.txt /app/apps/api/requirements.txt
RUN pip install --no-cache-dir -r apps/api/requirements.txt
COPY . /app
CMD ["sh","-c","alembic upgrade head && python scripts/bootstrap-admins.py && uvicorn apps.api.aiopt_web.main:app --host 0.0.0.0 --port 8000"]
